PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=file:./storage/payload.db
SERVER_URL=http://localhost:3000
# Either provider works independently. Never prefix keys with NEXT_PUBLIC_.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
# Persistent directory in production; defaults to ./storage/media
# MEDIA_DIR=/path/to/persistent/media
# Book search: Google key is optional; Open Library needs no key.
GOOGLE_BOOKS_API_KEY=
# Get WeRead key: https://weread.qq.com/r/weread-skills
WEREAD_API_KEY=
# TMDB: use a read access token (preferred) OR an API key.
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_KEY=
# Bangumi public search works without a token.
BANGUMI_ACCESS_TOKEN=
# BGG XML API now requires a registered application token.
BGG_API_TOKEN=
