# Copy to deploy/.env.production on the server; never commit the filled file.
# Compose interpolation: pass --env-file deploy/.env.production on every command.
HOST_DATA_DIR=/opt/traceonsnow/payload-data
APP_PORT=3000
APP_IMAGE_TAG=local

# Generate a different production secret: openssl rand -hex 32
PAYLOAD_SECRET=
SERVER_URL=https://traceonsnow.com

# All credentials are injected at container runtime, never during image build.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
GOOGLE_BOOKS_API_KEY=
WEREAD_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_KEY=
BANGUMI_ACCESS_TOKEN=
BGG_API_TOKEN=
