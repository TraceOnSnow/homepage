---
import EmptySvg from '@components/svg/EmptySvg';
import { resolveArticleCover } from '@lib/covers/data';
import { loadArticleCoverPool } from '@lib/covers/server';
import { loadLibraryWorks } from '@lib/library/server';
import type { Page } from 'astro';
import type { BlogPost, PostCardData } from 'types/blog';
import { getLocaleFromUrl, t } from '@/i18n';
import Paginator from './Paginator.astro';
import PostItemCard from './PostItemCard.astro';

interface Props {
  posts?: PostCardData[];
  page?: Page<BlogPost>;
  showPaginator?: boolean;
  baseUrl?: string; // 分页基础路径
  isHomePage?: boolean; // 是否是首页
}

const { posts, page, showPaginator = true, baseUrl, isHomePage = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
const [coverPool, works] = posts?.length ? await Promise.all([loadArticleCoverPool(), loadLibraryWorks()]) : [[], []];
const payloadMode = import.meta.env.CONTENT_SOURCE === 'payload';
---

{
  !posts?.length && (
    <div class="text-foreground/30 flex flex-col items-center gap-2">
      <EmptySvg className="fill-foreground/20" />
      <span>{t(locale, 'post.noPostsFound')}</span>
    </div>
  )
}
{
  posts && posts?.length > 0 && (
    <>
      <div class="flex flex-col gap-4">
        {posts.map((post) => (
          <PostItemCard
            key={post.slug}
            data={post}
            artwork={resolveArticleCover(post, works, coverPool, payloadMode)}
          />
        ))}
      </div>
      {showPaginator && page && <Paginator page={page} baseUrl={baseUrl} isHomePage={isHomePage} />}
    </>
  )
}
