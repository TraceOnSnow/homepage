---
import { ArticleNote } from '@components/common/ArticleNote';
import { Badge } from '@components/ui/badge';
import Divider from '@components/ui/divider';
import { type Project, projects } from '@/data/projects';
import { localizedPath, t } from '@/i18n';
import { getPostSlug, getSortedPosts } from '@/lib/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const posts = (await getSortedPosts(locale)).filter((post) => !post.data.draft);

const articleFor = (project: Project) => {
  const post = project.article ? posts.find((post) => getPostSlug(post) === project.article) : undefined;
  return post ? { title: post.data.title, url: localizedPath(`/post/${getPostSlug(post)}`, locale) } : undefined;
};

/** Site-internal links stay in the tab and follow the current locale; external links open a new tab. */
const linkAttrs = (url: string) =>
  url.startsWith('/') ? { href: localizedPath(url, locale) } : { href: url, target: '_blank', rel: 'noopener noreferrer' };

const featured = projects.filter((project) => project.featured);
const earlier = projects.filter((project) => !project.featured);
---

<section aria-labelledby="projects-heading" class="min-w-0" data-projects>
  <Divider><span id="projects-heading">{t(locale, 'projects.title')}</span></Divider>

  <div class="mt-4 flex flex-col gap-10">
    {featured.map((project) => (
      <article class="project-feature min-w-0" data-project-slug={project.slug}>
        <a {...linkAttrs(project.url)} class="bangumi-card group project-feature-cover"
          aria-label={t(locale, 'projects.open', { title: project.title })}>
          <div class="bangumi-poster project-poster">
            {project.cover ? (
              <img src={project.cover} alt={project.coverAlt ?? ''} width="1024" height="640" loading="lazy" decoding="async" />
            ) : (
              <span class="flex size-full items-center justify-center px-5 text-center font-semibold font-mono text-muted-foreground text-xl" aria-hidden="true">
                {project.title.slice(0, 2).toUpperCase()}
              </span>
            )}
          </div>
        </a>
        <div class="min-w-0">
          <h3 class="break-words font-semibold text-foreground text-lg">{project.title}</h3>
          {project.meta && <p class="mt-0.5 text-muted-foreground text-xs">{project.meta}</p>}
          <p class="mt-2 break-words text-sm leading-relaxed">{project.description}</p>

          {project.built && project.built.length > 0 && (
            <>
              <h4 class="project-label">{t(locale, 'projects.built')}</h4>
              <ul class="project-list">
                {project.built.map((item) => <li>{item}</li>)}
              </ul>
            </>
          )}

          {project.challenge && (
            <div class="project-challenge">
              <h4 class="font-semibold text-sm">{t(locale, 'projects.challenge')}：{project.challenge.title}</h4>
              <p class="mt-1 break-words text-muted-foreground text-sm leading-relaxed">{project.challenge.body}</p>
            </div>
          )}

          {project.stack && project.stack.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={t(locale, 'projects.stack')}>
              {project.stack.map((item) => (
                <li><Badge variant="secondary" className="font-normal">{item}</Badge></li>
              ))}
            </ul>
          )}

          {project.links && project.links.length > 0 && (
            <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
              {project.links.map((link) => (
                <a {...linkAttrs(link.url)} class="text-primary underline-offset-4 hover:underline">{link.label} →</a>
              ))}
            </p>
          )}
          <ArticleNote article={articleFor(project)} />
        </div>
      </article>
    ))}
  </div>

  {earlier.length > 0 && (
    <>
      <h3 class="mt-12 mb-4 font-semibold text-muted-foreground text-sm">{t(locale, 'projects.earlier')}</h3>
      <div class="project-grid grid gap-x-5 gap-y-6">
        {earlier.map((project) => (
          <article class="min-w-0" data-project-slug={project.slug}>
            <a {...linkAttrs(project.url)} class="bangumi-card group"
              aria-label={t(locale, 'projects.open', { title: project.title })}>
              <div class="bangumi-poster project-poster">
                {project.cover ? (
                  <img src={project.cover} alt={project.coverAlt ?? ''} width="1024" height="640" loading="lazy" decoding="async" />
                ) : (
                  <span class="flex size-full items-center justify-center px-5 text-center font-semibold font-mono text-muted-foreground text-xl" aria-hidden="true">
                    {project.title.slice(0, 2).toUpperCase()}
                  </span>
                )}
              </div>
              <h3 class="bangumi-title break-words" title={project.title}>{project.title}</h3>
            </a>
            <p class="mt-2 break-words text-muted-foreground text-sm leading-relaxed">{project.description}</p>
            <ArticleNote article={articleFor(project)} />
          </article>
        ))}
      </div>
    </>
  )}
</section>

<style>
  .project-feature {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 1.5rem;
    align-items: start;
  }

  /* Long write-ups keep their screenshot in view on wide screens. */
  .project-feature-cover {
    position: sticky;
    top: 5rem;
  }

  .project-feature + .project-feature {
    padding-top: 2.5rem;
    border-top: 1px dashed hsl(var(--border));
  }

  .project-label {
    margin-top: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .project-list {
    margin-top: 0.375rem;
    padding-left: 1.125rem;
    list-style: disc;
    font-size: 0.875rem;
    line-height: 1.65;
    color: hsl(var(--muted-foreground));
  }

  .project-list li + li {
    margin-top: 0.25rem;
  }

  .project-challenge {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-left: 3px solid hsl(var(--primary) / 0.6);
    border-radius: 0.5rem;
    background: hsl(var(--muted) / 0.5);
  }

  .project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .project-poster {
    aspect-ratio: 16 / 10;
  }

  .project-poster img {
    object-fit: contain;
  }

  @media (width <= 1023px) {
    .project-feature {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .project-feature-cover {
      position: static;
    }
  }

  @media (width <= 767px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.75rem;
    }
  }

  @media (width <= 359px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
