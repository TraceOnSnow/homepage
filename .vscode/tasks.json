{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Homepage：等待 Payload",
      "type": "process",
      "command": "zsh",
      "args": ["-lc", "node scripts/dev-service.mjs wait"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Homepage：检查网站",
      "type": "process",
      "command": "zsh",
      "args": ["-lc", "pnpm check && pnpm lint"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Homepage：准备生产试用",
      "type": "process",
      "command": "zsh",
      "args": ["-lc", "pnpm preview:prepare"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Homepage：检查生产试用产物",
      "type": "process",
      "command": "zsh",
      "args": ["-lc", "node scripts/prepare-preview.mjs --check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Homepage：更新静态页面",
      "type": "process",
      "command": "zsh",
      "args": ["-lc", "pnpm preview:refresh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
